engine-strict=true
# Aucun script de cycle de vie de dépendance (postinstall...) à l'installation : la CI traite des PR de forks.
# Vérifié : astro, esbuild et le build fonctionnent sans ; seul fsevents (optionnel, macOS) en déclare un,
# et il embarque déjà son binaire précompilé. Si une dépendance en exige un jour : `npm rebuild <paquet>` explicite.
ignore-scripts=true

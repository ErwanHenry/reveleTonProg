# Les extraits d'archives sont hachés octet par octet (sha256) : aucune conversion de fin de ligne.
archives/** -text
tests/fixtures/**/archives/** -text
# ids.lock est comparé ligne à ligne : toujours LF.
ids.lock text eol=lf
**/ids.lock text eol=lf
# Instantanés data.gouv hachés octet par octet : aucune conversion de fin de ligne.
data/import/*.json -text
# Scripts inclus dans les pages et autorisés par leur empreinte sha256 (CSP, ADR-056) : le navigateur ramène
# CR LF à LF avant de hacher, une copie en CRLF désynchroniserait l'empreinte calculée par Node.
src/scripts/*.js text eol=lf
# Blocs Caddy générés, comparés octet par octet à un rendu neuf (tests/repo/caddy.test.ts) : toujours LF.
deploy/caddy/*.caddy text eol=lf
# Fichiers du serveur (Phase 8), comparés octet par octet ou lancés par bash sur Linux : toujours LF.
ops/*.sh text eol=lf
deploy/compose/*.yml text eol=lf
deploy/cron/* text eol=lf

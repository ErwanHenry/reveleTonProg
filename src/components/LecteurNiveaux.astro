---
// Enveloppe de lecture d'une page : le contenu de la page est le slot par défaut.
// Le plan 04-05 ajoute ici le sélecteur de niveau (fieldset) et le bloc « Ce qui me concerne »,
// le plan 04-07 la liste « Mots expliqués » : les pages n'ont pas à changer.
import type { Contexte, VueMesure } from '../lib/corpus/index.ts';

interface Props {
  contexte: Contexte;
  mesures: readonly VueMesure[];
}

const { contexte, mesures } = Astro.props;
---
<div class="lecteur" data-contexte={contexte.type} data-nb-mesures={mesures.length}>
  <div class="lecteur-contenu">
    <slot />
  </div>
</div>

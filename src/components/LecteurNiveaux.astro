---
// Enveloppe de lecture d'une page : sélecteur de niveau (4 radios natifs), script de mémorisation,
// bloc « Ce qui me concerne », contenu de la page (slot par défaut) et rappel du niveau (sauf `rappel={false}`, accueil).
// La liste « Mots expliqués » (mots du glossaire des textes enfant de la page) suit le contenu : les pages n'ont rien à passer.
import '../styles/niveaux.css';
import niveauSource from '../scripts/niveau.js?raw';
import ConcerneAine from './ConcerneAine.astro';
import MotsExpliques from './MotsExpliques.astro';
import { termesDe } from '../lib/corpus/enfant.ts';
import { LIBELLES_NIVEAUX, NIVEAUX, getCorpus } from '../lib/corpus/index.ts';
import type { Contexte, VueMesure } from '../lib/corpus/index.ts';

interface Props {
  contexte: Contexte;
  mesures: readonly VueMesure[];
  /** Lien « Changer le niveau de lecture » en fin de contenu (faux sur l'accueil : le sélecteur y est juste au-dessus). */
  rappel?: boolean;
}

const { contexte, mesures, rappel = true } = Astro.props;
const corpus = await getCorpus();
---
<div class="lecteur" data-contexte={contexte.type} data-nb-mesures={mesures.length}>
  <fieldset class="niveaux" id="niveaux" aria-describedby="niveaux-aide">
    <legend>Niveau de lecture</legend>
    {NIVEAUX.map((niveau) => (
      <span class="niveau">
        <input type="radio" name="niveau" id={`niv-${niveau}`} value={niveau} checked={niveau === 'resume'} autocomplete="off" />
        <label for={`niv-${niveau}`}>{LIBELLES_NIVEAUX[niveau]}</label>
      </span>
    ))}
    <p id="niveaux-aide" class="aide">Ce choix s'applique à toutes les mesures de la page.</p>
    <p class="aide aide-sansjs">Sans JavaScript, votre choix n'est pas mémorisé d'une page à l'autre : il faut le refaire sur chaque page.</p>
    <p class="sr-only" role="status" data-niveau-annonce></p>
  </fieldset>
  <script is:inline set:html={niveauSource}></script>
  <div class="lecteur-contenu">
    <ConcerneAine contexte={contexte} mesures={mesures} />
    <slot />
    <MotsExpliques termes={termesDe(mesures, corpus.glossaire)} />
    {rappel && <p class="rappel-niveau"><a href="#niveaux">Changer le niveau de lecture</a></p>}
  </div>
</div>

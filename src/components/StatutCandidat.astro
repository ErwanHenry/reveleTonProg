---
// Statut d'une personnalité, en phrase : libellé, motif, jeu de données qui le porte, lien vers la source, date (M1-02).
// Décision du 2026-11-17 (« suivre le jeu, le dire, signaler les doutes ») : le site ne dit pas « depuis le » en son
// nom ; le statut et sa date sont attribués au jeu de données public et à la source qu'il cite.
// Texte à faire valider par Erwan.
// La page fournit le statut tel que le mode l'autorise (production : le dernier statut relu, sinon aucun).
import BadgeBrouillon from './BadgeBrouillon.astro';
import { LIBELLES_MOTIF, LIBELLES_STATUT, formatDate, texteSource } from '../lib/corpus/index.ts';
import type { PageCandidat } from '../lib/corpus/index.ts';
import { loadDatasetDatagouv } from '../lib/dataset-datagouv.ts';
import { NOM_JEU_DATAGOUV } from '../lib/identite.ts';

interface Props {
  page: PageCandidat;
}

const { page } = Astro.props;
const { statut } = page;
const motif = statut?.motif === undefined ? '' : ` (${LIBELLES_MOTIF[statut.motif]})`;
const jour = statut === null ? '' : formatDate(statut.date);
const jeu = loadDatasetDatagouv();
---
{statut === null ? (
  <p class="statut statut-attente">Statut en cours de vérification</p>
) : (
  <p class="statut">{LIBELLES_STATUT[statut.code]}{motif}, selon le jeu de données public <a href={jeu.page} rel="noopener noreferrer">{NOM_JEU_DATAGOUV}</a> (data.gouv.fr), qui cite : <a href={statut.source.url} rel="noopener noreferrer">{texteSource(statut.source)}</a>, <time datetime={statut.date}>{jour}</time>. <BadgeBrouillon texte={page.badgeStatut} /></p>
)}

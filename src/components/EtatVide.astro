---
import BadgeBrouillon from './BadgeBrouillon.astro';
import { BADGES, ETAT_VIDE_TEXTES, formatDate } from '../lib/corpus/index.ts';
import type { VueCellule } from '../lib/corpus/index.ts';

interface Props {
  cellule: VueCellule;
}

const { cellule } = Astro.props;
const date = cellule.verifieLe;
const titres = cellule.sourcesConsultees.map((s) => s.titre);
---
<p class="vide" data-etat={cellule.etat}>
  {cellule.etat === 'non_precise' && date !== undefined && (
    <>{ETAT_VIDE_TEXTES.non_precise.avant} <time datetime={date}>{formatDate(date)}</time>{ETAT_VIDE_TEXTES.non_precise.apres}</>
  )}
  {cellule.etat === 'programme_non_publie' && date !== undefined && (
    <>{ETAT_VIDE_TEXTES.programme_non_publie.avant} <time datetime={date}>{formatDate(date)}</time>{ETAT_VIDE_TEXTES.programme_non_publie.apres}</>
  )}
  {cellule.etat === 'non_verifie' && <>Case non vérifiée : à compléter avant publication. <BadgeBrouillon texte={BADGES.brouillon} /></>}
</p>
{titres.length > 0 && <p class="vide-sources">Sources consultées : {titres.join(', ')}.</p>}

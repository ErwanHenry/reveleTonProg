---
// Tuile d'un thème (accueil et /themes/) : numéro de rang, nom en lien (toute la carte en est la cible), nombre de candidats,
// pastille « Lire ». Le numéro et la pastille sont décoratifs (aria-hidden, U-06) : le numéro double le rang de la liste,
// « Lire » doublerait le nom du lien, qui reste le seul nom du thème.
import BadgeBrouillon from './BadgeBrouillon.astro';
import type { VueTheme } from '../lib/corpus/index.ts';

interface Props {
  vue: VueTheme;
  /** Rang de la tuile dans la liste rendue (1 pour la première), calculé par la page. Jamais le champ d ordre des données, qui a des trous. */
  rang: number;
  /** Seule tuile de l'accueil (un seul thème connu) : elle occupe toute la ligne de la grille. */
  une?: boolean;
}

const { vue, rang, une = false } = Astro.props;
const n = vue.cellules.length;
const numero = String(rang).padStart(2, '0');
---
<li class:list={['tuile', { 'tuile-une': une }]} data-theme={vue.theme.id}>
  <span class="tuile-num" aria-hidden="true">{numero}</span>
  <a class="tuile-lien" href={`/themes/${vue.theme.id}/`}>{vue.theme.nom}</a>
  <span class="tuile-compte">{n > 1 ? `${n} candidats` : `${n} candidat`}</span>
  <BadgeBrouillon texte={vue.badge} />
  <span class="tuile-lire" aria-hidden="true">Lire</span>
</li>

---
import { NOM_SITE } from '../../lib/identite.ts';
import Base from '../../layouts/Base.astro';
import BadgeBrouillon from '../../components/BadgeBrouillon.astro';
import OrdreCandidats from '../../components/OrdreCandidats.astro';
import { BADGES, LIBELLES_STATUT, formatDate, getCorpus } from '../../lib/corpus/index.ts';

const corpus = await getCorpus();
// Production : seules les personnes dont un statut a été relu sont listées (D-06, plan 09-15) ; le texte le dit.
const production = corpus.mode === 'production';
const k = corpus.nonRelus;
---
<Base
  titre={`Les candidats : ${NOM_SITE}`}
  description={production
    ? 'Les personnalités du jeu de données dont le statut a été relu, avec leur parti revendiqué et leur statut.'
    : 'Toutes les personnalités du jeu de données, avec leur parti revendiqué et leur statut.'}
  miseAJour={corpus.miseAJourIndex()}
>
  <main id="contenu" class="conteneur">
    <nav class="fil" aria-label="Fil d'Ariane">
      <ol>
        <li><a href="/">Accueil</a></li>
        <li aria-current="page">Candidats</li>
      </ol>
    </nav>
    <h1>Les candidats</h1>
    {corpus.candidats.length === 0 ? (
      <>
        <p>Aucun candidat à afficher pour le moment.</p>
        <p><a href="/">Revenir à l'accueil</a></p>
      </>
    ) : (
      <>
        <p>{production ? 'Les personnalités du jeu de données dont le statut a été relu' : 'Toutes les personnalités du jeu de données'}, par ordre alphabétique du nom, ou dans un ordre aléatoire si vous le choisissez ci-dessous. Le statut est celui de la dernière source consultée.</p>
        <OrdreCandidats />
        <ul class="lignes" data-ordonnable>
          {corpus.candidats.map((c) => {
            const statut = c.statutAffiche;
            return (
              <li class="ligne" data-rang={c.rang}>
                <p class="ligne-nom"><a href={`/candidats/${c.id}/`}>{c.nomAffiche}</a></p>
                <p class="ligne-parti">{c.parti === null ? 'Sans étiquette de parti déclarée' : `Parti revendiqué : ${c.parti}`}</p>
                <p class="ligne-statut">
                  {statut === null ? (
                    'Statut en cours de vérification'
                  ) : (
                    <>{LIBELLES_STATUT[statut.code]} · <time datetime={statut.date}>{formatDate(statut.date)}</time> <BadgeBrouillon texte={statut.statut_relecture === 'brouillon' ? BADGES.brouillon : null} /></>
                  )}
                </p>
              </li>
            );
          })}
        </ul>
      </>
    )}
    {k > 0 && (
      <p data-non-relus>
        {corpus.candidats.length === 0
          ? (k === 1
            ? '1 personnalité du jeu de données apparaîtra après relecture de son statut.'
            : `${k} personnalités du jeu de données apparaîtront après relecture de leur statut.`)
          : k === 1
            ? '1 autre personnalité du jeu de données apparaîtra après relecture de son statut.'
            : `${k} autres personnalités du jeu de données apparaîtront après relecture de leur statut.`}
      </p>
    )}
  </main>
</Base>

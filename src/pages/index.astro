---
import { getCandidats, getMesuresDe, getSource, statutCourant } from '../lib/corpus/index.ts';

const candidats = await getCandidats();
const vues = await Promise.all(
  candidats.map(async (c) => {
    const mesures = await getMesuresDe(c.id);
    const lignes = await Promise.all(mesures.map(async (m) => ({ mesure: m, source: await getSource(m.source) })));
    return { candidat: c, lignes };
  }),
);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>reveleTonProg — squelette (corpus fictif)</title>
  </head>
  <body>
    <h1>reveleTonProg — squelette</h1>
    {candidats.length === 0 ? (
      <p>Aucun candidat dans ce corpus.</p>
    ) : (
      <ul>
        {vues.map(({ candidat: c, lignes }) => {
          const statut = statutCourant(c);
          return (
            <li>
              {c.prenom} {c.nom}, {c.parti ?? 'Sans étiquette'} : {statut.code} — {statut.date}
              {lignes.map(({ mesure, source }) => (
                <div>
                  <h3>{mesure.titre}</h3>
                  <p>{mesure.redactions.resume}</p>
                  {source !== undefined && (
                    <p>Source : {source.titre}, consultée le {source.date_consultation}</p>
                  )}
                </div>
              ))}
            </li>
          );
        })}
      </ul>
    )}
    <p><span>Données fictives</span>
à des fins de test.</p>
  </body>
</html>

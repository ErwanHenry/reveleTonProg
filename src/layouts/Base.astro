---
import '../styles/base.css';
import '../styles/pages.css';
import ordreSource from '../scripts/ordre.js?raw';
import { formatDate, getCorpus } from '../lib/corpus/index.ts';
import { SOURCE_DATES, TOURS } from '../lib/dates-tours.ts';

interface Props {
  titre: string;
  description: string;
  /** Date ISO maximale des contenus affichés sur la page ; `undefined` si rien n'est publié. */
  miseAJour: string | undefined;
  /** Vrai si la page affiche au moins une mesure : ajoute la phrase de signalement avant le pied de page. */
  avecSignalement?: boolean;
}

const { titre, description, miseAJour, avecSignalement = false } = Astro.props;
const corpus = await getCorpus();
// Rubrique courante, déduite du chemin (trailingSlash: 'always') : aucun paramètre de page nécessaire.
const chemin = Astro.url.pathname;
const institutionnelle = /^\/(methode|mentions-legales|qui-sommes-nous)\/?$/.exec(chemin)?.[1];
const courante = /^\/themes(\/|$)/.test(chemin) ? 'themes' : /^\/candidats(\/|$)/.test(chemin) ? 'candidats' : undefined;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {corpus.mode === 'preview' && <meta name="robots" content="noindex" />}
    <script is:inline set:html={ordreSource}></script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <div class="conteneur entete-ligne">
        <a class="site-nom" href="/">reveleTonProg</a>
        <nav class="nav-principale" aria-label="Navigation principale">
          <ul>
            <li><a href="/themes/" aria-current={courante === 'themes' ? 'page' : undefined}>Thèmes</a></li>
            <li><a href="/candidats/" aria-current={courante === 'candidats' ? 'page' : undefined}>Candidats</a></li>
          </ul>
        </nav>
      </div>
    </header>
    {corpus.mode === 'preview' && (
      <div class="banniere-preview bandeau-apercu">Version de prévisualisation : contenus non relus, ne pas diffuser.</div>
    )}
    <slot />
    {avecSignalement && (
      <div class="conteneur">
        <p class="signalement-intro">Vous avez repéré une erreur ? Signalez-la : l'identifiant de la mesure est déjà indiqué dans le message.</p>
      </div>
    )}
    <footer class="pied">
      <div class="conteneur">
        {miseAJour === undefined ? (
          <p data-mise-a-jour>Aucun contenu publié pour le moment.</p>
        ) : (
          <p data-mise-a-jour>Dernière mise à jour des contenus de cette page : <time datetime={miseAJour}>{formatDate(miseAJour)}</time>.</p>
        )}
        <p><span>Ce site</span>
n'utilise aucun cookie et n'appelle aucun service extérieur.</p>
        <p>Élection présidentielle : premier tour le dimanche <time datetime={TOURS[0].date}>{formatDate(TOURS[0].date)}</time>, second tour le dimanche <time datetime={TOURS[1].date}>{formatDate(TOURS[1].date)}</time>.{SOURCE_DATES !== null && (<>
{' '}(<a href={SOURCE_DATES.url} rel="noopener noreferrer">source officielle</a>)</>)}</p>
        <nav aria-label="Informations sur le site" class="pied-liens">
          <ul>
            <li><a href="/methode/" aria-current={institutionnelle === 'methode' ? 'page' : undefined}>Méthode</a></li>
            <li><a href="/mentions-legales/" aria-current={institutionnelle === 'mentions-legales' ? 'page' : undefined}>Mentions légales</a></li>
            <li><a href="/qui-sommes-nous/" aria-current={institutionnelle === 'qui-sommes-nous' ? 'page' : undefined}>Qui sommes-nous</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>

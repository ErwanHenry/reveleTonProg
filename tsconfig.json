{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "tests/**/*.ts", "e2e/**/*", "playwright.config.ts"],
  "exclude": ["dist", "tests/fixtures"]
}
